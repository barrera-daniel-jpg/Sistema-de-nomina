datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  GERENTE
  ADMIN
  OPERARIO
}

enum RecordStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PeriodStatus {
  DRAFT
  LIQUIDATED
  APPROVED
  ANNULLED
}

enum DetailType {
  INCOME
  DEDUCTION
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  role          Role      @default(OPERARIO)
  createdAt     DateTime  @default(now())
  employee      Employee?
}

model Profile {
  id          String     @id @default(uuid())
  name        String     @unique
  employees   Employee[]
}

model Employee {
  id            String    @id @default(uuid())
  document      String    @unique
  fullName      String
  baseSalary    Float
  childrenCount Int       @default(0)
  
  userId        String?   @unique
  user          User?     @relation(fields: [userId], references: [id])
  
  profileId     String
  profile       Profile   @relation(fields: [profileId], references: [id])
  
  timeRecords   TimeRecord[]
  settlements   PayrollSettlement[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model HourType {
  id          String       @id @default(uuid())
  name        String       @unique
  multiplier  Float        // e.g., 1.0, 1.35, 1.75
  records     TimeRecord[]
}

model TimeRecord {
  id          String    @id @default(uuid())
  date        DateTime
  hours       Float
  status      RecordStatus @default(PENDING)
  
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  
  hourTypeId  String
  hourType    HourType  @relation(fields: [hourTypeId], references: [id])
}

model PayrollPeriod {
  id          String       @id @default(uuid())
  name        String       // Ej. "Octubre 2026 - Quincena 1"
  startDate   DateTime
  endDate     DateTime
  status      PeriodStatus @default(DRAFT)
  
  settlements PayrollSettlement[]
}

model PayrollSettlement {
  id              String         @id @default(uuid())
  totalDevengado  Float
  totalBonus      Float
  totalDeductions Float
  netToPay        Float
  
  periodId        String
  period          PayrollPeriod  @relation(fields: [periodId], references: [id])
  
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id])
  
  details         PayrollDetail[]
}

model PayrollDetail {
  id            String            @id @default(uuid())
  concept       String            // Ej. "Bono por 2 hijos", "Salud (4%)", "Horas Extras"
  type          DetailType
  amount        Float
  
  settlementId  String
  settlement    PayrollSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
}
